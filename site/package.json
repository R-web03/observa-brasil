{
  "name": "observa-brasil",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "node scripts/sincronizar-design.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sincronizar-design.mjs",
    "build": "astro check && node scripts/verificar-rascunhos.mjs && astro build && pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "check": "node scripts/sincronizar-design.mjs && astro check",
    "novo": "node scripts/novo.mjs",
    "ingerir": "tsx --env-file-if-exists=.env scripts/ingerir.ts",
    "astro": "astro",
    "verificar-rascunhos": "node scripts/verificar-rascunhos.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.17",
    "@supabase/supabase-js": "^2.118.0",
    "astro": "^7.4.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0",
    "zod": "^4.6.6"
  }
}
