# Copie para .env (que nunca vai para o Git) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Endereço público do site
SITE_URL=https://observa-brasil.vercel.app

# Supabase (Settings → API). A service_role é SECRETA: só servidor, nunca no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da rotina agendada. Gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# Sal para o hash de IP nos pedidos de correção. Gere do mesmo jeito.
IP_HASH_SALT=

# Opcional: deploy hook da Vercel, chamado quando a coleta traz dado novo.
DEPLOY_HOOK_URL=
