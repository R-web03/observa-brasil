---
import '../styles/ds-tokens.css';
import '../styles/ds-components.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Rodape from '../components/Rodape.astro';
import Glossa from '../components/Glossa.astro';

interface Props {
  titulo: string;
  descricao?: string;
  rascunho?: boolean;
  emRevisao?: boolean;
  imagem?: string; // caminho da imagem de compartilhamento (1200 x 630)
}

const { titulo, descricao = 'Economia explicada com calma, com fontes e sem torcida.', rascunho = false, emRevisao = false, imagem } = Astro.props;
const tituloCompleto = Astro.url.pathname === '/' ? 'Observa Brasil' : `${titulo} · Observa Brasil`;
const canonico = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonico} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonico} />
    {imagem && <meta property="og:image" content={new URL(imagem, Astro.site)} />}
    {imagem && <meta property="og:image:width" content="1200" />}
    {imagem && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imagem ? "summary_large_image" : "summary"} />
    {(rascunho || emRevisao) && <meta name="robots" content="noindex" />}
    <!-- Aplica o tema salvo (ou o do sistema) antes de pintar a página, sem piscar. -->
    <script is:inline>
      (function () {
        var tema = null;
        try { tema = localStorage.getItem('tema'); } catch (e) {}
        if (tema !== 'light' && tema !== 'grafite') {
          tema = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'grafite';
        }
        document.documentElement.setAttribute('data-theme', tema);
      })();
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Nav />
    <main id="conteudo" class="pagina" data-pagefind-body={rascunho ? undefined : ''}>
      {
        rascunho && (
          <p class="faixa-rascunho" role="note">
            <strong>Rascunho.</strong> Esta página só aparece no ambiente de desenvolvimento e não será publicada até ser aprovada.
          </p>
        )
      }
      {
        emRevisao && (
          <p class="faixa-rascunho faixa-revisao" role="note">
            <strong>Versão em revisão.</strong> Este texto ainda não passou pelos revisores externos e pode mudar.
            Achou um erro? <a href="/correcoes">Peça uma correção</a>.
          </p>
        )
      }
      <slot />
    </main>
    <Rodape />
    <Glossa />
  </body>
</html>
