---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada">
  <header class="cabecalho">
    <div class="ob-eyebrow">Erro 404</div>
    <h1 class="ob-headline">Esta página não existe</h1>
    <p class="ob-deck">Talvez o endereço tenha mudado. Tente a busca ou comece pelo curso.</p>
  </header>
  <div class="ob-row">
    <a class="ob-btn ob-btn--primary" href="/busca">Buscar um tema</a>
    <a class="ob-btn ob-btn--secondary" href="/curso">Ver o curso</a>
  </div>
</Base>
