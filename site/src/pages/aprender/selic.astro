  { situacao: 'Já tem financiamento com juro prefixado', como: 'A parcela não muda: o juro foi fixado na assinatura. Confira no contrato se ele é prefixado.', tipo: 'direto', quando: 'na hora', natureza: 'observado' },
  { situacao: 'Vai pegar crédito novo', como: 'Carro, moto, casa ou empréstimo pessoal tendem a sair mais caros nos meses seguintes.', tipo: 'direto', quando: 'em meses', natureza: 'provavel' },
  { situacao: 'Paga juros do cartão ou do cheque especial', como: 'Esses juros já são muito altos por causa do risco de calote, e mudam relativamente menos que a Selic.', tipo: 'direto', quando: 'em meses', natureza: 'provavel' },
  { situacao: 'Tem dinheiro aplicado', como: 'Tesouro Selic e CDBs pelo CDI rendem mais logo. A poupança só até o teto da regra.', tipo: 'direto', quando: 'na hora', natureza: 'observado' },
