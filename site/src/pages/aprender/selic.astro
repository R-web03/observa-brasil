      { titulo: 'O emprego esfria, ou cresce mais devagar', como: 'É o efeito colateral. Em 2021 e 2022, o desemprego caiu mesmo com a Selic subindo, porque a economia saía da pandemia.', natureza: 'em-disputa', fonte: 'IBGE, PNAD Contínua', fatores: ['governo', 'fora'] },
