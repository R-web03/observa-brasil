---
import Base from '../../layouts/Base.astro';
import Piramide from '../../components/Piramide.astro';
import GraficoInterativo from '../../components/GraficoInterativo.astro';
import Compartilhar from '../../components/Compartilhar.astro';
import { ESTUDOS, ROTULO_ORIGEM, type Estudo } from '../../lib/impactos';
import { GOVERNOS, buscarGoverno } from '../../lib/governos';
import { SERIES_ESTATICAS } from '../../lib/series-estaticas';

export function getStaticPaths() {
  const ordem = (e: Estudo) => GOVERNOS.findIndex((g) => g.id === e.governo) * 10000 + Number(e.inicio.replace('-', ''));
  const lista = [...ESTUDOS].sort((a, b) => ordem(a) - ordem(b));
  return lista.map((estudo, i) => ({ params: { id: estudo.id }, props: { estudo, anterior: lista[i - 1], proximo: lista[i + 1] } }));
}

const { estudo: e, anterior, proximo } = Astro.props;
const g = buscarGoverno(e.governo);
const pontos = e.grafico ? SERIES_ESTATICAS[e.grafico.serie] ?? [] : [];
---

<Base titulo={e.titulo} descricao={e.resumo} emRevisao imagem={`/compartilhar/${e.id}.png`}>
  <article class="estudo-pagina">
    <header class="cabecalho">
      <p class="ob-eyebrow">
        <a href="/impactos">Impactos</a>
        <span class="ob-eyebrow-sep">·</span>
        {g && <a href={`/governos/${g.id}`}>{g.nome}</a>}
        <span class="ob-eyebrow-sep">·</span>
        <span>{e.quando}</span>
      </p>
      <h1 class="ob-headline">{e.titulo}</h1>
      <p class="ob-deck">{e.resumo}</p>
      <p class="estudo-quem">Quem decidiu: {e.quemDecidiu}</p>
    </header>

    <section aria-labelledby="piramide-t">
      <h2 id="piramide-t" class="t-title-2">Quem ganhou e quem pagou</h2>
      <p class="secao-deck">Toque em cada faixa para ver como a decisão chega ao bolso e quem está ali.</p>
      <Piramide estudo={e} />
      {e.quemPaga && <p class="estudo-paga"><strong>Quem mais paga a conta:</strong> {e.quemPaga}</p>}
    </section>

    {
      e.caminho && (
        <section aria-labelledby="caminho-t" class="estudo-bloco">
          <h2 id="caminho-t" class="t-title-2">Como chega no seu bolso, passo a passo</h2>
          <ol class="caminho">
            {e.caminho.map((p) => (
              <li class="caminho-passo">
                <span class="caminho-rotulo">{p.passo}</span>
                <p>{p.texto}</p>
                {p.evidencia && <span class="camada-evidencia">Evidência: <strong>{p.evidencia}</strong></span>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      e.exemplo && (
        <section aria-labelledby="exemplo-t" class="estudo-bloco">
          <h2 id="exemplo-t" class="t-title-2">Na ponta do lápis</h2>
          <div class="exemplo">
            <p class="exemplo-titulo">{e.exemplo.titulo}</p>
            <ul>
              {e.exemplo.linhas.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
            <p class="exemplo-aviso">{e.exemplo.aviso}</p>
          </div>
        </section>
      )
    }

    {
      e.origens && (
        <section aria-labelledby="origens-t" class="estudo-bloco">
          <h2 id="origens-t" class="t-title-2">De quem é esse resultado?</h2>
          <p class="secao-deck">Separamos o que foi decisão do governo da vez, o que ele recebeu de antes e o que veio de fora.</p>
          <ul class="origens">
            {e.origens.map((o) => (
              <li class:list={['origem', `origem--${o.origem}`]}>
                <span class="origem-tipo">{ROTULO_ORIGEM[o.origem]}</span>
                <span class="origem-titulo">{o.titulo}</span>
                {o.valor && <span class="origem-valor">{o.valor}</span>}
                <p>{o.texto}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      e.grafico && pontos.length > 1 && (
        <section class="estudo-bloco">
          <GraficoInterativo
            titulo={e.grafico.titulo}
            descricao={e.grafico.descricao}
            pontos={pontos}
            unidade={e.grafico.unidade}
            casas={e.grafico.casas}
            cor="var(--chart-3)"
            destacar={e.governo}
          >
            <p class="ob-chart-foot">{e.grafico.descricao} Fonte: IBGE, IPCA. Cálculo do Observa Brasil.</p>
          </GraficoInterativo>
        </section>
      )
    }

    <div class="artigo largo estudo-texto">
      <h2>Os fatos</h2>
      <ul>
        {e.fatos.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
      <h2>O que ainda não se sabe</h2>
      <p>{e.naoSabemos}</p>
      <p class="tg-rodape">
        Fontes:{' '}
        {e.fontes.map((f, i) => (
          <>
            {i > 0 && ' · '}
            <a href={f.url} rel="noopener">{f.nome}</a>
          </>
        ))}
      </p>
    </div>

    <Compartilhar titulo={e.titulo} caminho={`/impactos/${e.id}`} imagem={`/compartilhar/${e.id}.png`} />

    <nav class="navegacao-aula" aria-label="Outros estudos">
      {anterior && <a class="ob-btn ob-btn--secondary" href={`/impactos/${anterior.id}`}>← Anterior</a>}
      <a class="ob-btn ob-btn--secondary" href="/impactos">Todos os estudos</a>
      {proximo && <a class="ob-btn ob-btn--primary" href={`/impactos/${proximo.id}`}>Próximo →</a>}
    </nav>
  </article>
</Base>
