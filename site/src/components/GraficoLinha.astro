---
// Gráfico de linha simples, gerado no build como SVG (sem JavaScript no navegador).
// Acessível: role="img", título que diz a conclusão e tabela de dados equivalente.
import type { Ponto } from '../lib/dados';
import { formatarMesAno, formatarNumero } from '../lib/formato';

interface Props {
  titulo: string;
  descricao: string;
  pontos: Ponto[];
  unidade: string;
  casas?: number;
}

const { titulo, descricao, pontos, unidade, casas = 1 } = Astro.props;
const L = 720, A = 280, M = { topo: 16, dir: 16, base: 32, esq: 48 };

const valores = pontos.map((p) => p.valor);
const min = Math.min(...valores, 0);
const max = Math.max(...valores);
const x = (i: number) => M.esq + (i / Math.max(pontos.length - 1, 1)) * (L - M.esq - M.dir);
const y = (v: number) => M.topo + (1 - (v - min) / (max - min || 1)) * (A - M.topo - M.base);
const caminho = pontos.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(p.valor).toFixed(1)}`).join(' ');
const marcas = [min, (min + max) / 2, max];
const idTitulo = `g-${Math.abs(titulo.split('').reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
const ultimos = pontos.slice(-24).reverse();
---

{
  pontos.length > 1 && (
    <figure class="ob-chart">
      <figcaption class="ob-chart-title" id={idTitulo}>{titulo}</figcaption>
      <svg viewBox={`0 0 ${L} ${A}`} role="img" aria-labelledby={idTitulo} aria-describedby={`${idTitulo}-d`}>
        <desc id={`${idTitulo}-d`}>{descricao}</desc>
        {marcas.map((m) => (
          <g>
            <line x1={M.esq} x2={L - M.dir} y1={y(m)} y2={y(m)} stroke="var(--chart-grid)" />
            <text x={M.esq - 8} y={y(m) + 4} text-anchor="end" font-size="12" fill="var(--ink-muted)">
              {formatarNumero(m, casas)}
            </text>
          </g>
        ))}
        <path class="grafico-linha" d={caminho} pathLength="1" fill="none" stroke="var(--accent)" stroke-width="2" />
        <text x={M.esq} y={A - 8} font-size="12" fill="var(--ink-muted)">{formatarMesAno(new Date(pontos[0]!.data))}</text>
        <text x={L - M.dir} y={A - 8} text-anchor="end" font-size="12" fill="var(--ink-muted)">
          {formatarMesAno(new Date(pontos.at(-1)!.data))}
        </text>
      </svg>
      <details>
        <summary>Ver dados (últimos {ultimos.length})</summary>
        <div class="tabela-rolagem">
          <table class="ob-table">
            <thead><tr><th scope="col">Data</th><th scope="col">Valor ({unidade})</th></tr></thead>
            <tbody>
              {ultimos.map((p) => (
                <tr><td>{formatarMesAno(new Date(p.data))}</td><td class="ob-num">{formatarNumero(p.valor, casas)}{p.preliminar && ' (preliminar)'}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <slot />
    </figure>
  )
}
