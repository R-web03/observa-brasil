---
import { ROTULO_STATUS, finalizado } from '../lib/conteudo';

interface Props {
  href: string;
  titulo: string;
  resumo?: string;
  etiqueta?: string;
  status?: string;
}
const { href, titulo, resumo, etiqueta, status } = Astro.props;
---

<a class="ob-card ob-card--link" href={href}>
  <div class="ob-card-head">
    {etiqueta && <span class="ob-tag ob-tag--section">{etiqueta}</span>}
    {status && !finalizado(status) && <span class="ob-tag ob-tag--warm">{ROTULO_STATUS[status]}</span>}
  </div>
  <h2 class="t-title-3">{titulo}</h2>
  {resumo && <p class="t-body">{resumo}</p>}
</a>
