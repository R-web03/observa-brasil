---
import Marca from './Marca.astro';

const LINKS = [
  { href: '/curso', rotulo: 'Curso' },
  { href: '/conceitos', rotulo: 'Conceitos' },
  { href: '/analises', rotulo: 'Análises' },
  { href: '/comparacoes', rotulo: 'Comparações' },
  { href: '/metodo', rotulo: 'Método' },
];
const atual = Astro.url.pathname;
const ativo = (href: string) => atual === href || atual.startsWith(`${href}/`);
---

<header class="topo">
  <nav class="ob-nav ob-nav--glass" aria-label="Principal">
    <a class="ob-nav-brand" href="/"><Marca />Observa<span>.</span>Brasil</a>
    <ul data-menu-principal>
      {
        LINKS.map((l) => (
          <li>
            <a href={l.href} aria-current={ativo(l.href) ? 'page' : undefined}>
              {l.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="menu-destaque" aria-hidden="true"></span>
    <a class="ob-nav-search" href="/busca">
      Buscar um tema
      <span class="ob-iconbtn ob-iconbtn--inverse" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </span>
    </a>
    <button type="button" class="ob-btn ob-btn--ghost ob-btn--sm" data-alternar-tema aria-label="Alternar tema claro e escuro">
      Tema
    </button>
    <!-- No celular o design system esconde a lista acima; este menu a substitui (funciona sem JavaScript). -->
    <details class="menu-movel">
      <summary class="ob-btn ob-btn--secondary ob-btn--sm">Menu</summary>
      <ul>
        {
          LINKS.map((l) => (
            <li>
              <a href={l.href} aria-current={ativo(l.href) ? 'page' : undefined}>
                {l.rotulo}
              </a>
            </li>
          ))
        }
        <li><button type="button" data-alternar-tema>Alternar tema claro e escuro</button></li>
      </ul>
    </details>
  </nav>
</header>

<script>
  // Troca entre Grafite e Claro e lembra a escolha (localStorage pode falhar: modo privado).
  // Há dois botões: um na barra (computador) e um dentro do menu (celular).
  // O tema novo se abre num círculo a partir do botão (View Transitions); onde não houver suporte, troca direto.
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLButtonElement>('[data-alternar-tema]').forEach((botao) => botao.addEventListener('click', () => {
    const raiz = document.documentElement;
    const novo = raiz.getAttribute('data-theme') === 'light' ? 'grafite' : 'light';
    const trocar = () => {
      raiz.setAttribute('data-theme', novo);
      try {
        localStorage.setItem('tema', novo);
      } catch {
        /* sem armazenamento: vale só para esta visita */
      }
    };
    if (!('startViewTransition' in document) || semMovimento.matches) return trocar();
    const r = botao.getBoundingClientRect();
    const cx = r.left + r.width / 2;
    const cy = r.top + r.height / 2;
    const raio = Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy));
    document.startViewTransition(trocar).ready.then(() => {
      raiz.animate(
        { clipPath: [`circle(0px at ${cx}px ${cy}px)`, `circle(${raio}px at ${cx}px ${cy}px)`] },
        { duration: 480, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  }));

  // Destaque do item atual: um único fundo que desliza de um item para outro.
  // Cada clique é uma navegação nova, então a posição de saída fica no sessionStorage
  // e a página seguinte começa dali. Sem JavaScript, vale o fundo do próprio design system.
  const nav = document.querySelector<HTMLElement>('.ob-nav');
  const lista = nav?.querySelector<HTMLElement>('[data-menu-principal]');
  const destaque = nav?.querySelector<HTMLElement>('.menu-destaque');
  const CHAVE = 'menu-destaque';

  if (nav && lista && destaque) {
    nav.classList.add('tem-destaque');
    const atualLink = () => lista.querySelector<HTMLElement>('a[aria-current="page"]');

    // Usa left e right (e não transform) para as duas bordas andarem em tempos diferentes:
    // a borda da frente chega primeiro e a de trás alcança, como no vídeo de referência.
    const colocar = (x: number, largura: number, visivel: boolean, animar: boolean) => {
      const xAtual = parseFloat(destaque.style.left);
      destaque.classList.toggle('sem-transicao', !animar);
      destaque.classList.toggle('vai-esquerda', x < xAtual);
      destaque.style.left = `${x}px`;
      destaque.style.right = `${nav.getBoundingClientRect().width - x - largura}px`;
      destaque.style.opacity = visivel ? '1' : '0';
    };
    const posicaoDe = (alvo: HTMLElement) => {
      const n = nav.getBoundingClientRect();
      const r = alvo.getBoundingClientRect();
      return { x: r.left - n.left, largura: r.width };
    };
    const irPara = (alvo: HTMLElement | null, animar: boolean) => {
      if (!alvo) return colocar(0, 0, false, animar);
      const p = posicaoDe(alvo);
      colocar(p.x, p.largura, true, animar);
    };

    // Ponto de partida: onde o destaque estava na página anterior.
    let anterior: { x: number; largura: number } | null = null;
    try {
      anterior = JSON.parse(sessionStorage.getItem(CHAVE) ?? 'null');
    } catch {
      /* sem armazenamento: o destaque só aparece, sem deslizar */
    }
    const alvo = atualLink();
    if (anterior && anterior.largura > 0) {
      colocar(anterior.x, anterior.largura, true, false);
      destaque.getBoundingClientRect(); // fixa a posição inicial antes de animar
      irPara(alvo, true);
    } else if (alvo) {
      const p = posicaoDe(alvo);
      colocar(p.x, p.largura, false, false);
      destaque.getBoundingClientRect();
      colocar(p.x, p.largura, true, true); // primeira visita: surge com um fade curto
    }

    // No clique já começa a deslizar; a navegação segue normalmente, sem esperar.
    lista.querySelectorAll<HTMLElement>('a').forEach((a) => a.addEventListener('click', () => irPara(a, true)));

    // Guarda a posição visível (mesmo no meio da animação) ao sair da página.
    window.addEventListener('pagehide', () => {
      try {
        const r = destaque.getBoundingClientRect();
        const visivel = getComputedStyle(destaque).opacity !== '0' && r.width > 0;
        if (visivel) sessionStorage.setItem(CHAVE, JSON.stringify({ x: r.left - nav.getBoundingClientRect().left, largura: r.width }));
        else sessionStorage.removeItem(CHAVE);
      } catch {
        /* sem armazenamento */
      }
    });
    // Voltar pelo navegador (cache de página) ou mudar a largura da janela: recoloca sem animar.
    window.addEventListener('pageshow', (e) => { if (e.persisted) irPara(atualLink(), false); });
    window.addEventListener('resize', () => irPara(atualLink(), false));
    // A fonte do site chega depois do primeiro desenho e muda a largura dos itens: reajusta o alvo.
    document.fonts?.ready.then(() => irPara(atualLink(), true));
  }
</script>
