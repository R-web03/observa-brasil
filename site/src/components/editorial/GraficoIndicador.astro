---
// Gráfico de um indicador dentro de uma aula ou análise, com dados reais do banco
// e a linha de fonte obrigatória. Uso no MDX:
// <GraficoIndicador id="ipca-12-meses" titulo="A inflação subiu forte em 2021 e 2022" />
// O título diz a conclusão; ele precisa ser verdadeiro para a série inteira mostrada.
import { getEntry } from 'astro:content';
import GraficoInterativo from '../GraficoInterativo.astro';
import Fonte from './Fonte.astro';
import Aviso from './Aviso.astro';
import { mensal, observacoes } from '../../lib/dados';
import { corDaSerie } from '../../lib/cores';
import { formatarData, formatarMesAno } from '../../lib/formato';

interface Props {
  id: string;
  titulo: string;
  desde?: string; // AAAA-MM-DD
  casas?: number;
}
const { id, titulo, desde, casas } = Astro.props;
const ficha = await getEntry('indicadores', id);
if (!ficha) throw new Error(`<GraficoIndicador id="${id}">: ficha não encontrada em src/content/indicadores/`);
const d = ficha.data;
// Séries diárias (Selic) viram mensais: o gráfico fica leve e a forma não muda.
const brutos = await observacoes(id, desde);
const pontos = d.frequencia === 'diaria' ? mensal(brutos) : brutos;
const primeiro = pontos[0];
const ultimo = pontos.at(-1);
const periodo = primeiro && ultimo ? `${formatarMesAno(new Date(primeiro.data))} a ${formatarMesAno(new Date(ultimo.data))}` : '';
---

{
  primeiro && ultimo && pontos.length > 1 ? (
    <GraficoInterativo titulo={titulo} descricao={`${d.nome}, ${periodo}.`} pontos={pontos} unidade={d.unidade} casas={casas} cor={corDaSerie(id)} anual={d.frequencia === "anual"}>
      <Fonte fonte={`${d.instituicao}, ${d.serie}`} link={d.link} periodo={periodo} unidade={d.unidade} consulta={formatarData(new Date())} />
    </GraficoInterativo>
  ) : (
    <Aviso tipo="info" titulo="Gráfico indisponível">
      A série de {d.nome} ainda não foi carregada. Os dados aparecem aqui depois da coleta automática.
    </Aviso>
  )
}
