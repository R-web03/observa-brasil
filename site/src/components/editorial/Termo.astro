---
// Termo técnico com link para o verbete e o balão com a definição curta.
// Uso no MDX: <Termo id="ipca">IPCA</Termo>
// Na maior parte do texto não é preciso: o plugin do glossário marca os termos sozinho.
// Use <Termo> quando a palavra do texto não for o nome nem um sinônimo do verbete.
import { getEntry } from 'astro:content';
import { visivel } from '../../lib/conteudo';

interface Props {
  id: string;
}
const { id } = Astro.props;
const verbete = await getEntry('verbetes', id);
if (!verbete) throw new Error(`<Termo id="${id}">: verbete não encontrado em src/content/verbetes/`);
const publicado = visivel(verbete.data.status);
---

{
  publicado ? (
    <a class="glossa" href={`/conceitos/${id}`} data-termo={verbete.data.termo} data-def={verbete.data.definicao}>
      <slot />
    </a>
  ) : (
    <span>
      <slot />
    </span>
  )
}
